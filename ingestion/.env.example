# ==============================================================================
# SyncScholar Offline Ingestion Pipeline Environment Variables Template
# Copy this file to .env before running textbook ingestion scripts.
# NEVER commit the real .env file to Git repository.
# ==============================================================================

# MongoDB Atlas Connection URI
# Needs read/write access to the `syncscholar` database.
# How to obtain:
# 1. MongoDB Atlas console (https://cloud.mongodb.com/) -> Connect -> Drivers -> Python.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Target Database and Collection Name
DATABASE_NAME=syncscholar
COLLECTION_NAME=curriculum_chunks

# Google Gemini API Key
# Used for generating dense vector embeddings for curriculum chunks
# via Google AI Studio's embedding model (e.g. text-embedding-004) or OpenAI.
# How to obtain: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Model Name
# e.g., models/text-embedding-004 or text-embedding-3-small
EMBEDDING_MODEL=models/text-embedding-004
