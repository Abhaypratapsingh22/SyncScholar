# ==============================================================================
# SyncScholar Server Environment Variables Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the real .env file to Git repository.
# ==============================================================================

# Port for Express API server (default: 5000)
PORT=5000

# Node execution environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Atlas Connection URI
# How to obtain:
# 1. Sign up / Log in to MongoDB Atlas (https://cloud.mongodb.com/).
# 2. Create a free M0 cluster in your preferred region.
# 3. Under Database Access, create a database user and password.
# 4. Under Network Access, whitelist your current IP address (or 0.0.0.0/0 for dev).
# 5. Click "Connect" -> "Drivers" -> Node.js and copy the connection string.
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/syncscholar?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/syncscholar?retryWrites=true&w=majority

# Google Gemini API Key (Used for LLM Socratic tutoring & quiz generation)
# How to obtain:
# 1. Visit Google AI Studio: https://aistudio.google.com/
# 2. Sign in with your Google account.
# 3. Click "Get API key" and create a key in a new or existing GCP project.
GEMINI_API_KEY=your_gemini_api_key_here

# JSON Web Token Secret
# Used to sign & verify session tokens for Students and Teachers.
# How to generate: Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` in your terminal.
JWT_SECRET=your_jwt_super_secret_key_min_32_characters_long

# Allowed Client Origin (for CORS configuration)
# The URL where your Vite frontend runs during development.
CLIENT_URL=http://localhost:5173
