# ==============================================================================
# SyncScholar Client Environment Variables Template
# Copy this file to .env and customize for your local development environment.
# Note: In Vite, only variables prefixed with VITE_ are exposed to client code.
# ==============================================================================

# Backend API Base URL
# The HTTP endpoint of the SyncScholar Express backend.
# In local development, the backend typically runs on http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
